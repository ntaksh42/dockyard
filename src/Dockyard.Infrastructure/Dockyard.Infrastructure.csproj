<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows implementation of the application's ports: Win32 window operations, hooks, files, logging. -->
  <PropertyGroup>
    <!-- The startup task (WinRT) needs the Windows 10 SDK projection. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Hosts the Remote Desktop ActiveX control. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the remote desktop window uses WinForms; keep its types out of the global namespace. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dockyard.Application\Dockyard.Application.csproj" />
    <ProjectReference Include="..\Dockyard.Domain\Dockyard.Domain.csproj" />
  </ItemGroup>

</Project>
