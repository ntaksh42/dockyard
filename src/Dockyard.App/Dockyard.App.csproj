<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Dockyard.Domain\Dockyard.Domain.csproj" />
    <ProjectReference Include="..\Dockyard.Infrastructure\Dockyard.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Keep the exe named Dockyard.exe. -->
    <AssemblyName>Dockyard</AssemblyName>
    <RootNamespace>Dockyard.App</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Dockyard.ico</ApplicationIcon>
    <!-- WFO0003 targets WinForms apps; this is a WPF app, where the manifest is the way to set per-monitor DPI. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Dockyard.ico" />
    <!-- Only the tray icon uses WinForms; keep its types out of the global namespace to avoid clashes with WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
