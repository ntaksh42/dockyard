<Window x:Class="Dockyard.App.LayoutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Saved Layouts" Width="420" Height="360" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip" Icon="Assets/Dockyard.ico">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button Content="Delete" Width="80" Click="Delete_Click" />
            <Button Content="Close" Width="80" DockPanel.Dock="Right" IsCancel="True" Click="Close_Click" />
            <Button Content="Open" Width="80" DockPanel.Dock="Right" Margin="0,0,8,0" IsDefault="True" Click="Open_Click" />
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button Content="Rename" Width="80" DockPanel.Dock="Right" Margin="8,0,0,0" Click="Rename_Click" />
            <TextBox x:Name="NameBox" VerticalContentAlignment="Center" PreviewKeyDown="NameBox_KeyDown" />
        </DockPanel>
        <TextBlock x:Name="Message" DockPanel.Dock="Bottom" Foreground="#B91C1C" Margin="0,6,0,0" Visibility="Collapsed" />
        <ListBox x:Name="List" DisplayMemberPath="Name" SelectionChanged="List_SelectionChanged" MouseDoubleClick="Open_Click" />
    </DockPanel>
</Window>
