<Window x:Class="Dockyard.App.GroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1000" Height="700" WindowStartupLocation="CenterScreen" Icon="Assets/Dockyard.ico"
        WindowStyle="None" ResizeMode="CanResize" Background="#2B2F36">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <DockPanel x:Name="Root">
        <Grid x:Name="Caption" DockPanel.Dock="Top" Height="30" MouseEnter="Caption_MouseEnter">
            <!-- Shown only while the pointer is over the caption (see ShowCaptionInfo). -->
            <StackPanel x:Name="CaptionInfo" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,140,0" Opacity="0">

                <Border x:Name="GroupChip" Background="#3B82F6" CornerRadius="9" Padding="8,1" ToolTip="Double-click to rename"
                        WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonDown="GroupChip_MouseLeftButtonDown">
                    <Grid>
                        <TextBlock x:Name="GroupNameText" Foreground="White" FontSize="12" />
                        <TextBox x:Name="GroupNameEdit" FontSize="12" MinWidth="80" Padding="0" BorderThickness="0" Visibility="Collapsed"
                                 KeyDown="GroupNameEdit_KeyDown" LostKeyboardFocus="GroupNameEdit_LostKeyboardFocus" />
                    </Grid>
                </Border>
                <TextBlock x:Name="ActiveTitleText" Foreground="#E5E7EB" FontSize="12" Margin="8,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="&#x2014;" Click="Minimize_Click" Style="{StaticResource CaptionButton}" />
                <Button Content="&#x2610;" Click="Maximize_Click" Style="{StaticResource CaptionButton}" />
                <Button Content="&#x2715;" Click="Close_Click" Style="{StaticResource CaptionButton}" />
            </StackPanel>
        </Grid>
        <Canvas x:Name="Surface" Margin="4,0,4,4" ClipToBounds="True" Background="Transparent" />
    </DockPanel>
</Window>
