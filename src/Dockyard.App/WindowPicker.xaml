<Window x:Class="Dockyard.App.WindowPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="ウィンドウを選ぶ" Width="560" Height="420" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="追加" Width="80" IsDefault="True" Click="Ok_Click" />
            <Button Content="キャンセル" Width="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
        <ListBox x:Name="List" MouseDoubleClick="Ok_Click" />
    </DockPanel>
</Window>
