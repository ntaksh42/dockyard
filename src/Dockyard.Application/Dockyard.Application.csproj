<Project Sdk="Microsoft.NET.Sdk">

  <!-- Application layer: decides what to do with a group's windows. Talks to the outside only through the
       ports in Ports.cs, so it has no Windows or WPF dependency and is unit-tested with fakes. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dockyard.Domain\Dockyard.Domain.csproj" />
  </ItemGroup>

</Project>
