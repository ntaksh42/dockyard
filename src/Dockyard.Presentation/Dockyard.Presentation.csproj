<Project Sdk="Microsoft.NET.Sdk">

  <!-- Frames, dialogs and the tray, in WPF. Sees the application through its ports only: no Infrastructure. -->
  <ItemGroup>
    <ProjectReference Include="..\Dockyard.Application\Dockyard.Application.csproj" />
    <ProjectReference Include="..\Dockyard.Domain\Dockyard.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Dockyard.Presentation</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Dockyard.ico" />
    <!-- Only the tray icon uses WinForms; keep its types out of the global namespace to avoid clashes with WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
