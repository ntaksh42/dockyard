<Window x:Class="Dockyard.Presentation.Internal.Views.RemoteDesktopPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Remote Desktop" Width="520" Height="380" MinWidth="400" MinHeight="260" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip" Icon="pack://application:,,,/Dockyard.Presentation;component/Assets/Dockyard.ico" ThemeMode="Dark"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" DockPanel.Dock="Right" />
            <Button x:Name="ConnectButton" Content="_Connect" Width="80" IsDefault="True" Click="Connect_Click" DockPanel.Dock="Right" />
            <Button Content="_New…" Width="70" Click="New_Click" DockPanel.Dock="Left" />
            <Button x:Name="EditButton" Content="_Edit…" Width="70" Margin="8,0,0,0" Click="Edit_Click" DockPanel.Dock="Left" />
            <Button x:Name="DeleteButton" Content="_Delete" Width="70" Margin="8,0,0,0" Click="Delete_Click" DockPanel.Dock="Left" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Enter: connect  ·  F2: edit  ·  Delete: delete" />
        <Grid>
            <ListBox x:Name="List" MouseDoubleClick="Connect_Click" SelectionChanged="List_SelectionChanged"
                     AutomationProperties.Name="Remote Desktop connections" />
            <TextBlock x:Name="EmptyText" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="24"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="No connections yet. Choose New… to add the computer to connect to." />
        </Grid>
    </DockPanel>
</Window>
