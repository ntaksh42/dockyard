<Window x:Class="Dockyard.Presentation.Internal.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Dockyard Settings" Width="660" Height="640" MinWidth="540" MinHeight="420"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Dockyard.Presentation;component/Assets/Dockyard.ico" ThemeMode="Dark"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}">
    <!-- Dark like the group frames. Each tab scrolls when a small or scaled-up screen cannot show it whole. -->
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <Button Content="Close" Width="80" DockPanel.Dock="Right" IsCancel="True" Click="Close_Click" />
        </DockPanel>
        <TabControl x:Name="SettingsTabs">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Tab bar position" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <TextBlock Text="Applies to every group. A group can change its own from its caption's right-click menu."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <RadioButton x:Name="TopOption" Tag="Top" Content="Above the window (default)" Margin="0,0,0,6" Checked="Placement_Checked" />
                        <RadioButton x:Name="TitleBarOption" Tag="TitleBar" Content="Over the window's title bar" Margin="0,0,0,6" Checked="Placement_Checked" />
                        <RadioButton x:Name="LeftOption" Tag="Left" Content="Vertical, left of the window" Checked="Placement_Checked" />
                        <TextBlock Text="Apps that keep their own title bar (tabs go above them instead), exe names separated by commas:"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,10,0,4" TextWrapping="Wrap" HorizontalAlignment="Left" />
                        <TextBox x:Name="TitleBarAppsBox" LostKeyboardFocus="TitleBarAppsBox_LostKeyboardFocus" />

                        <TextBlock Text="Startup" FontWeight="SemiBold" Margin="0,20,0,8" />
                        <CheckBox x:Name="AutostartBox" Content="Start Dockyard when Windows starts" IsEnabled="False" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="LayoutsTab" Header="Layouts">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Saved layouts" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <TextBlock Text="Save a layout with the save button on a group's caption. To open one from anywhere, click its Hotkey field and press the keys (Ctrl, Alt or Win plus a key). Esc cancels."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <Grid x:Name="LayoutGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <TextBlock x:Name="NoLayoutsText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="No saved layouts yet. Save one with the save button on a group's caption." />
                        <TextBlock x:Name="LayoutMessage" Visibility="Collapsed" Foreground="#F87171" Margin="0,6,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="Opening layouts" FontWeight="SemiBold" Margin="0,20,0,8" />
                        <CheckBox x:Name="OpenLastGroupsBox" Content="When Dockyard starts, open the groups from last time" Margin="0,0,0,6" />
                        <CheckBox x:Name="LaunchMissingAppsBox" Content="When opening a layout, start apps that are not open" />
                        <TextBlock Text="Opening a layout from its hotkey or desktop shortcut always starts the apps that are not open."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Shortcuts">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Keyboard shortcuts" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Click a shortcut, then press the new keys (Ctrl, Alt or Win plus a key). Esc cancels."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <Grid x:Name="ShortcutGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <Button Content="Reset Shortcuts" Padding="10,2" Margin="0,16,0,0" HorizontalAlignment="Left" Click="ResetShortcuts_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
