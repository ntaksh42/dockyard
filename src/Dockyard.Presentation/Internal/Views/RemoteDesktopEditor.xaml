<Window x:Class="Dockyard.Presentation.Internal.Views.RemoteDesktopEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Remote Desktop Connection" Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Icon="pack://application:,,,/Dockyard.Presentation;component/Assets/Dockyard.ico" ThemeMode="Dark">
    <StackPanel Margin="16">
        <Label Content="_Name" Target="{Binding ElementName=NameBox}" Padding="0,0,0,2" />
        <TextBox x:Name="NameBox" Margin="0,0,0,10" />
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Label Content="_Computer (host name or IP address)" Target="{Binding ElementName=HostBox}" Padding="0,0,0,2" />
                <TextBox x:Name="HostBox" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <Label Content="_Port" Target="{Binding ElementName=PortBox}" Padding="0,0,0,2" />
                <TextBox x:Name="PortBox" />
            </StackPanel>
        </Grid>
        <Label Content="_User name" Target="{Binding ElementName=UserBox}" Padding="0,0,0,2" />
        <TextBox x:Name="UserBox" Margin="0,0,0,10" />
        <Label Content="_Domain (optional)" Target="{Binding ElementName=DomainBox}" Padding="0,0,0,2" />
        <TextBox x:Name="DomainBox" Margin="0,0,0,10" />
        <Label Content="P_assword" Target="{Binding ElementName=PasswordBox}" Padding="0,0,0,2" />
        <PasswordBox x:Name="PasswordBox" />
        <TextBlock x:Name="PasswordNote" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Kept in the Windows Credential Manager, not in Dockyard's files." />
        <CheckBox x:Name="ForgetPasswordBox" Content="_Forget the saved password" Margin="0,6,0,0" Visibility="Collapsed" />
        <TextBlock x:Name="ErrorText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFFF6B6B" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Width="80" IsDefault="True" Click="Save_Click" />
            <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
