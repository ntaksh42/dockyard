<Project Sdk="Microsoft.NET.Sdk">

  <!-- Drives a real Dockyard.exe through UI Automation and real mouse input, then checks window geometry
       and z-order through Win32. It takes over the desktop for about a minute, so it is run by hand:
       "dotnet run" in tests/Dockyard.UiTests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

</Project>
