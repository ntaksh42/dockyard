<Project Sdk="Microsoft.NET.Sdk">

  <!-- Drives a real Dockyard.exe through UI Automation and real mouse input, then checks window geometry
       and z-order through Win32. It takes over the desktop for about a minute, so it is run by hand:
       "dotnet run" in tests/Dockyard.UiTests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- For System.Drawing: the perf run reads the screen to see blank panes. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The manifest sets per-monitor DPI so real mouse coordinates match window rectangles. This project never calls
         ApplicationConfiguration.Initialize, so the ApplicationHighDpiMode property WFO0003 suggests would not apply. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

</Project>
